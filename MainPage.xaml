<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipCalculatorPart2.MainPage"
             Title="TipCalculator Part2"
             Appearing="ContentPage_Appearing"
             Disappearing="ContentPage_Disappearing"
             >

    <ScrollView HeightRequest="550" WidthRequest="350" x:Name="pageBackground">
        <VerticalStackLayout HorizontalOptions="Center">
            <VerticalStackLayout HorizontalOptions="Center">
                <HorizontalStackLayout>
                    <Label
                         Text="Bill"
                         FontSize="20"
                         WidthRequest="100"
                     />
                    <Label
                         x:Name="billAmount"
                         Text="$0.00"
                         FontSize="20"
                         WidthRequest="100"
                     />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label
                         Text="Tip"
                         FontSize="20"
                         WidthRequest="100"
                     />
                    <Label
                         x:Name="tipAmount"
                         Text="$0.00"
                         FontSize="20"
                         WidthRequest="100"
                     />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label
                         Text="Total"
                         FontSize="20"
                         WidthRequest="100"
                     />
                    <Label
                         x:Name="totalAmount"
                         Text="$0.00"
                         FontSize="20"
                         WidthRequest="100"
                     />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label
                         Text="Cost per Diner"
                         FontSize="20"
                         WidthRequest="150"
                     />
                    <Label
                         x:Name="perDinerAmount"
                         Text="$0.00"
                         FontSize="20"
                     />
                </HorizontalStackLayout>
                
                <HorizontalStackLayout>
                    <Label
                Text="Diners"
                FontSize="20"
                WidthRequest="100"
                />

                    <Label
                x:Name="dinersAmount"
                Text="1"
                FontSize="20"
                WidthRequest="85"
                />

                    <Stepper
                x:Name="dinerStepperAmount"
                Scale="0.75"
                Minimum="1"
                Value="1"
                Increment="1"
                ValueChanged="DinerStepperAmount_ValueChanged"
                />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout HorizontalOptions="Center">
                <Label HeightRequest="20"/>
                <HorizontalStackLayout>
                    <Button
                    x:Name="buttonSeven"
                    Text="7"
                    FontSize="20"
                    Clicked="ButtonClicked"
                />
                    <Button
                    x:Name="buttonEight"
                    Text="8"
                    FontSize="20"
                    Clicked="ButtonClicked"                       
                />
                    <Button
                    x:Name="buttonNine"
                    Text="9"
                    FontSize="20"
                    Clicked="ButtonClicked"                        
                />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Button
                    x:Name="buttonFour"
                    Text="4"
                    FontSize="20"
                    Clicked="ButtonClicked"                        
                />
                    <Button
                    x:Name="buttonFive"
                    Text="5"
                    FontSize="20"
                    Clicked="ButtonClicked" 
                />
                    <Button
                    x:Name="buttonSix"
                    Text="6"
                    FontSize="20"
                    Clicked="ButtonClicked" 
                />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Button
                    x:Name="buttonOne"
                    Text="1"
                    FontSize="20"
                    Clicked="ButtonClicked" 
                />
                    <Button
                    x:Name="buttonTwo"
                    Text="2"
                    FontSize="20"
                    Clicked="ButtonClicked" 
                />
                    <Button
                    x:Name="buttonThree"
                    Text="3"
                    FontSize="20"
                    Clicked="ButtonClicked" 
                />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Button
                    x:Name="buttonZero"
                    Text="0"
                    FontSize="20"
                    Clicked="ButtonClicked" 
                />
                    <Button
                    x:Name="buttonDecimal"
                    Text="."
                    FontSize="20"
                    Clicked="Point_Clicked"
                />
                    <Button
                    x:Name="buttonClear"
                    Text="C"
                    FontSize="20"
                    Clicked="ClearButtonClicked" 
                />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            
            <VerticalStackLayout HorizontalOptions="Center">
                <HorizontalStackLayout>
                    <Slider
                        x:Name="percentageSlider"
                        Minimum="0"                    
                        Maximum="100"
                        WidthRequest="250"
                        ValueChanged="SliderValueChanged"                        
                    />
                    <Label WidthRequest="15"/>
                    <Label
                        x:Name="percentageLabel"
                        Text="0%"                    
                    />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button 
                x:Name="moveToPreferences" 
                Text="Preferences" 
                Clicked="moveToPreferences_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
